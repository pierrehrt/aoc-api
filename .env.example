# Copy to .env for local runs. Never commit .env — it holds a real connection string.
# Production values live in Railway's variables and nowhere else (AOC-004).

PORT=8080

# Which environment answered, reported by /health as "env". Local runs say "local"
# (the default when unset, so nothing ever claims to be production by accident);
# Railway sets "production".
ENV=local

# Local Postgres from docker-compose.yml. Note port 5433, not 5432 — see that file.
# In production Railway injects DATABASE_URL pointing at its PRIVATE hostname; never paste the
# public proxy URL in, it bills egress and adds latency for no benefit.
DATABASE_URL=postgres://aoc:aoc@localhost:5433/aoc_dev?sslmode=disable

# The origin canonical URLs and og:image are built from. Set on Railway to the live origin.
# Deliberately NOT derived from the request host: the same page reached by two hostnames would
# otherwise declare two different canonicals, which is the duplicate-content problem the
# canonical tag exists to solve. Unset locally it falls back to http://localhost:$PORT.
PUBLIC_BASE_URL=http://localhost:8080
