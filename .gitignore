# build output
/bin/
/aoc-api

# local env — never commit a connection string
.env
.env.*
!.env.example

.DS_Store

# ⛔ DATABASE DUMPS ARE NEVER COMMITTED.
# tmp/dumps/ holds real production dumps pulled down to rehearse migrations. That is the entire
# researched dataset — and, once EP-06 ships, real accounts. A dump in git history cannot be
# un-published: it survives every later deletion, in every clone, forever.
# NOTE the trailing /* on the first line. `/tmp/` would exclude the DIRECTORY, and git does not
# descend into an excluded directory — so every negation below it silently does nothing, and
# tmp/dumps/ does not survive a fresh clone. Caught by `git check-ignore`, not by reading.
/tmp/*
!/tmp/dumps/
/tmp/dumps/*
!/tmp/dumps/.gitkeep

# Downloaded build tools (Tailwind standalone). Pinned by version + SHA-256 in the
# Makefile and re-downloaded on demand, so there is no reason to commit 74 MB.
.tools/

# Python bytecode from scripts/ (the backup alarm's tests import check_backup_freshness).
__pycache__/
*.pyc
